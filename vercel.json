{
  "rewrites": [
    {
      "source": "/productos/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/producto/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/categoria/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/categorias/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|favicon|apple-touch-icon|robots\\.txt|sitemap\\.xml|site\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
